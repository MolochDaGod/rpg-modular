{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/auth/:path*", "dest": "https://api.grudge-studio.com/api/auth/:path*" },
    { "src": "/api/:path*",      "dest": "https://api.grudge-studio.com/api/:path*" },
    { "src": "/(.*)",            "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://grudge-studio.com https://grudgewarlords.com https://id.grudge-studio.com https://*.grudge-studio.com https://*.vercel.app"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/rpg-maker-studio/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/embed/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}